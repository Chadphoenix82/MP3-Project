<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Allowlist mode: include only Room database and DataStore preferences.
         Cached artwork (covers/), wallpapers/, and temporary WAV exports are automatically excluded. -->
    <cloud-backup>
        <include domain="database" path="photon_audio.db" />
        <include domain="file" path="datastore/photon_audio_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="photon_audio.db" />
        <include domain="file" path="datastore/photon_audio_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
